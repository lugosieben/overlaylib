{
	"schemaVersion": 1,
	"id": "overlaylib",
	"version": "${version}",
	"name": "OverlayLib",
	"description": "Library for rendering live info-overlays",
	"authors": [
		"Lugo_Sieben"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/overlaylib",
        "issues": "https://github.com/lugosieben/overlaylib/issues/new",
        "sources": "https://github.com/lugosieben/overlaylib"
	},
